<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Config.fs"/>
        <Compile Include="Handler\ErrorHandlerAsync.fs"/>
        <Compile Include="Handler\CollectorHandlerAsync.fs"/>
        <Compile Include="Handler\UpdateHandlerAsync.fs"/>
        <Compile Include="Handler\StartHandlerAsync.fs" />
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12"/>
        <PackageReference Include="Telegram.Bot" Version="22.10.3.1"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
